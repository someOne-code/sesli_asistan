        "responseMode": "responseNode",
        "options": {}
      },
      "id": "Webhook_In",
      "name": "Vapi Webhook In",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        -1320,
        180
      ],
      "webhookId": "melody-vapi-router"
    },
    {
      "parameters": {
        "jsCode": "const body = $json.body ?? $json;\n\nconst call = body.call || {};\nconst transcript = body.transcript || call.transcript || '';\nconst analysis = body.analysis || call.analysis || {};\n\nconst tenantId = body.tenant_id || body.tenantId || call.metadata?.tenant_id || call.metadata?.tenantId || '';\nconst serviceId = body.service_id || body.serviceId || analysis.service_id || analysis.serviceId || '';\n\nconst normalized = {\n  raw: body,\n  tenant_id: tenantId,\n  call_id: body.call_id || body.callId || call.id || '',\n  customer_phone: body.customer_phone || body.customerPhone || call.customer?.number || call.phoneNumber || '',\n  customer_name: body.customer_name || body.customerName || call.customer?.name || '',\n  requested_start_time: body.start_time || body.requested_start_time || analysis.requested_start_time || null,\n  start_date: body.start_date || analysis.start_date || null,\n  end_date: body.end_date || analysis.end_date || null,\n  service_id: serviceId,\n  transcript,\n  analysis,\n  intent: (body.intent || analysis.intent || '').toString().toUpperCase(),\n};\n\nreturn [{ json: normalized }];"
      },
      "id": "Normalize_Input",
      "name": "Normalize Input",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -1080,
        180
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": false,
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "leftValue": "={{$json.intent}}",
              "rightValue": "BOOK_APPOINTMENT",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "If_Book",
      "name": "Intent = BOOK_APPOINTMENT?",
