        -600,
        260
      ]
    },
    {
      "parameters": {
        "url": "={{$env.SUPABASE_URL + '/rest/v1/rpc/create_appointment_from_call'}}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{$env.SUPABASE_SERVICE_ROLE_KEY}}"
            },
            {
              "name": "Authorization",
              "value": "={{'Bearer ' + $env.SUPABASE_SERVICE_ROLE_KEY}}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"p_tenant_id\": $json.tenant_id,\n  \"p_call_id\": $json.call_id,\n  \"p_service_id\": $json.service_id,\n  \"p_start_time\": $json.requested_start_time,\n  \"p_customer_phone\": $json.customer_phone,\n  \"p_customer_name\": $json.customer_name\n}",
        "options": {}
      },
      "id": "Supabase_Create_Appointment",
      "name": "RPC: create_appointment_from_call",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -360,
        -40
      ]
    },
    {
      "parameters": {
        "jsCode": "const r = $json;\n\nreturn [{\n  json: {\n    action: 'BOOK_APPOINTMENT',\n    success: !!r.success,\n    message: r.success\n      ? `Randevu oluşturuldu. ID: ${r.appointment_id}`\n      : `Randevu oluşturulamadı: ${r.error || 'bilinmeyen hata'}`,\n    data: r\n  }\n}];"
      },
      "id": "Build_Book_Response",
      "name": "Build Booking Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -120,
        -40
      ]
    },
    {
      "parameters": {
        "url": "={{$env.SUPABASE_URL + '/rest/v1/rpc/check_availability'}}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{$env.SUPABASE_SERVICE_ROLE_KEY}}"
            },
            {
              "name": "Authorization",
              "value": "={{'Bearer ' + $env.SUPABASE_SERVICE_ROLE_KEY}}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"p_tenant_id\": $json.tenant_id,\n  \"p_service_id\": $json.service_id,\n  \"p_start_date\": $json.start_date || $now.format('YYYY-MM-DD'),\n  \"p_end_date\": $json.end_date || null\n}",
        "options": {}
      },
      "id": "Supabase_Check_Availability",
      "name": "RPC: check_availability",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -360,
        260
      ]
    },
    {
      "parameters": {
        "jsCode": "const r = $json;\n\nconst dayCount = Array.isArray(r.available_slots) ? r.available_slots.length : 0;\n\nreturn [{\n  json: {\n    action: 'CHECK_AVAILABILITY',\n    success: !!r.success,\n    message: r.success\n      ? `Müsaitlik bulundu. ${dayCount} gün için slot var.`\n      : `Müsaitlik kontrolü başarısız: ${r.error || 'bilinmeyen hata'}`,\n    data: r\n  }\n}];"
      },
      "id": "Build_Availability_Response",
      "name": "Build Availability Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -120,
        260
      ]
    },
    {
      "parameters": {
        "jsCode": "const intent = $json.intent || 'UNKNOWN';\n\nreturn [{\n  json: {\n    action: intent,\n    success: false,\n    message: `Intent yönlendirilemedi: ${intent}. Beklenen: BOOK_APPOINTMENT veya CHECK_AVAILABILITY`,\n    data: $json\n  }\n}];"
      },
      "id": "Build_Fallback_Response",
      "name": "Build Fallback Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -120,
        520
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{$json}}",
        "options": {}
      },
